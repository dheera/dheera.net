// Install as /etc/apt/apt.conf.d/20auto-upgrades.
// Use Ubuntu's packaged security origins in 50unattended-upgrades.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
// Reboots are performed deliberately after checking /var/run/reboot-required.
Unattended-Upgrade::Automatic-Reboot "false";
