{% if photo %}<img src="{{ photo.thumb or photo.src }}"{% if photo.srcset %} srcset="{{ photo.srcset }}"{% endif %} sizes="{{ imageSizes or '(max-width: 700px) 100vw, 70vw' }}" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ photo.alt or photo.title or '' }}" loading="{{ 'eager' if imageEager else 'lazy' }}"{% if imageEager %} fetchpriority="high"{% endif %} decoding="async">{% else %}<div class="missing-image" aria-label="{{ view.t.noImage }}"></div>{% endif %}
