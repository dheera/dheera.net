{% set project = view.project %}
<article class="project-detail"><header class="page-intro"><a href="{{ view.links.projects }}" class="back-link" data-local-link><span aria-hidden="true">←</span> {{ view.t.allProjects }}</a><h1>{{ project.title }}</h1>{% if project.summary %}<p>{{ project.summary }}</p>{% endif %}{% set actions = project.detailActions %}{% include 'partials/project-actions.njk' %}</header>
  {% if project.video.provider == 'youtube' %}<figure class="project-media project-embed{% if project.video.portrait %} is-portrait{% endif %}"><iframe src="{{ project.video.src }}" title="{{ project.title }} — {{ view.t.watchVideo }}" width="{% if project.video.portrait %}360{% else %}560{% endif %}" height="{% if project.video.portrait %}640{% else %}315{% endif %}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe><figcaption><a class="text-link" href="{{ project.video.href }}">{{ view.t.watchOnYouTube }} <span aria-hidden="true">↗</span></a></figcaption></figure>
  {% elif project.video.src %}<div class="project-media"><video controls playsinline preload="metadata"{% if project.cover.src %} poster="{{ project.cover.src }}"{% endif %}><source src="{{ project.video.src }}"{% if project.video.type %} type="{{ project.video.type }}"{% endif %}><a href="{{ project.video.src }}">{{ view.t.videoFallback }}</a></video></div>
  {% elif project.cover %}<figure class="project-media">{% set photo = project.cover %}{% set imageEager = true %}{% set imageSizes = '(max-width: 1100px) 100vw, 1100px' %}{% include 'partials/image.njk' %}</figure>{% endif %}
  {% if project.bodyHtml %}<div class="prose project-body">{{ project.bodyHtml | safe }}</div>{% endif %}
</article>
<div class="project-end"><a class="text-link" href="{{ view.links.projects }}" data-local-link>{{ view.t.allProjects }} <span aria-hidden="true">→</span></a></div>
