<section class="home-intro" aria-labelledby="home-title">
  <div class="intro-overline"><span>{{ view.site.name }}</span><span class="intro-type">{{ view.t.photographyExploration }}</span></div>
  <h1 id="home-title">{% if view.site.headlineHtml %}{{ view.site.headlineHtml | safe }}{% elif view.site.headline %}{{ view.site.headline }}{% else %}{{ view.t.midnightHeadline | safe }}{% endif %}</h1>
  <div class="intro-bottom">
    <div class="intro-description">{% if view.site.introHtml %}{{ view.site.introHtml | safe }}{% else %}<p>{{ view.site.intro or view.t.intro }}</p>{% endif %}</div>
    {% if view.socialLinks | length %}<nav class="home-social-links" aria-label="{{ view.t.socialProfiles }}">
      {% for link in view.socialLinks %}<a class="social-link" href="{{ link.href }}">{% include 'partials/social-icon.njk' %}{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}
    </nav>{% endif %}
  </div>
</section>
<section id="collections" class="collections-section" aria-label="{{ view.t.photos }}">
  {% if view.galleries | length %}<div class="collection-grid">
    {% for gallery in view.galleries %}{% set cardIndex = loop.index %}{% include 'partials/collection-card.njk' %}{% endfor %}
  </div>{% else %}<div class="empty-state"><h2>{{ view.t.emptyTitle }}</h2><p>{{ view.t.emptyDescription }}</p></div>{% endif %}
</section>
<aside class="about-note"><span class="eyebrow">{{ view.t.elsewhere }}</span><p>{{ view.t.projectsIntro | safe }}</p><div><a href="{{ view.links.projects }}" data-local-link>{{ view.t.exploreProjects }} <span aria-hidden="true">→</span></a></div></aside>
