<!doctype html>
<html lang="{{ view.language }}" data-style="{{ view.defaultStyle }}"{% if view.designPreview %} data-design-preview="true"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{% if view.defaultStyle == 'midnight' %}#151917{% elif view.defaultStyle == 'museum' %}#ffffff{% else %}#f4f1eb{% endif %}">
  <title>{{ view.title }}</title>
  <meta name="description" content="{{ view.description }}">
  <link rel="canonical" href="{{ view.canonical }}">
  {% for alternative in view.alternates %}<link rel="alternate" hreflang="{{ alternative.language }}" href="{{ alternative.href }}">{% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ view.xDefault }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ view.site.name }}">
  <meta property="og:title" content="{{ view.title }}">
  <meta property="og:description" content="{{ view.description }}">
  <meta property="og:url" content="{{ view.canonical }}">
  <meta property="og:locale" content="{{ view.ogLocale }}">
  {% if view.ogImage %}<meta property="og:image" content="{{ view.ogImage }}">
  <meta property="og:image:alt" content="{{ view.ogImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">{% endif %}
  {% if view.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  {% if view.redirect %}<meta http-equiv="refresh" content="0;url={{ view.redirect }}">{% endif %}
  <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  {% if view.kind == 'gallery' and view.gallery.layout != 'pairs' %}<link rel="stylesheet" href="/vendor/photoswipe/photoswipe.css">{% endif %}
  <link rel="stylesheet" href="/assets/tokens.css">
  <link rel="stylesheet" href="/assets/styles.css">
  {% if view.kind == 'gallery' and view.gallery.layout == 'pairs' %}<link rel="stylesheet" href="/assets/pairs.css">{% endif %}
  {% if view.kind == 'about' and view.about.travelMap %}<link rel="stylesheet" href="/assets/travel-map.css">{% endif %}
  <script src="/assets/site.js" defer></script>
  {% if view.kind == 'gallery' and view.gallery.layout != 'pairs' %}<script type="module" src="/assets/gallery.js"></script>{% endif %}
  {% if view.kind == 'about' and view.about.travelMap %}<script type="module" src="/assets/travel-map.js"></script>{% endif %}
</head>
<body class="{{ view.bodyClass }}">
  <a class="skip-link" href="#main">{{ view.t.skip }}</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
</body>
</html>
